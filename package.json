{
	"name": "dressup",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.4",
	"scripts": {
		"auth:schema": "auth generate --config src/worker/auth-cli.ts --output src/worker/db/auth-schema.ts --yes && biome check --write src/worker/db/auth-schema.ts",
		"build": "tsc -b && vite build",
		"cf-typegen": "wrangler types",
		"check": "biome check . && tsc -b",
		"prepare": "sh scripts/setup-git-hooks.sh",
		"db:generate": "bun scripts/db-generate.ts",
		"db:migrate:local": "wrangler d1 migrations apply dressup --local",
		"deploy": "bun run build && wrangler d1 migrations apply dressup --remote && wrangler deploy",
		"dev": "vite",
		"e2e": "playwright test",
		"preview": "bun run build && vite preview",
		"test": "bun test"
	},
	"dependencies": {
		"@better-auth/cimd": "1.7.25",
		"@better-auth/mcp": "1.7.25",
		"@better-auth/oauth-provider": "1.7.25",
		"@modelcontextprotocol/server": "2.4.0",
		"@tailwindcss/vite": "4.3.5",
		"@tanstack/react-query": "5.107.1",
		"better-auth": "1.7.25",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.5.2",
		"drizzle-orm": "0.45.4",
		"hono": "4.11.1",
		"lucide-react": "^1.72.0",
		"radix-ui": "^1.8.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-router": "8.5.1",
		"tailwindcss": "4.3.5",
		"tw-animate-css": "^1.4.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.7",
		"@cloudflare/vite-plugin": "1.52.1",
		"@playwright/test": "1.65.0",
		"@types/bun": "^1.4.4",
		"@types/node": "^26.6.6",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "5.1.1",
		"auth": "1.7.25",
		"drizzle-kit": "0.31.11",
		"typescript": "5.9.3",
		"vite": "^7.0.0",
		"wrangler": "^4.161.0"
	},
	"patchedDependencies": {
		"@better-auth/cimd@1.7.25": "patches/@better-auth%2Fcimd@1.7.25.patch"
	}
}
