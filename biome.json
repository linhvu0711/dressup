{
	"$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": ["**", "!worker-configuration.d.ts", "!**/docs", "!migrations"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noExplicitAny": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["src/react-app/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedGlobals": {
							"level": "error",
							"options": {
								"deniedGlobals": {
									"fetch": "Send requests through request() in src/react-app/data/client.ts."
								}
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/react-app/data/client.ts"],
			"linter": { "rules": { "style": { "noRestrictedGlobals": "off" } } }
		}
	],
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}
